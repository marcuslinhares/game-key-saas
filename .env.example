# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (para pagamentos com cartão/crypto global)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Mercado Pago (para pagamentos Pix - Brasil)
MERCADO_PAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Criptografia AES-256-GCM para chaves de jogos (obrigatório)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Site URL (para webhooks e redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
